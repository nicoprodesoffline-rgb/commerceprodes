{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "dom"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".bc2-build",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["lib/site-db/**/*.ts", "lib/site-publish/**/*.ts"]
}
