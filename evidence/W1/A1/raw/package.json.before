{
  "name": "prodes-commerce-bc1-d",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:http": "node spike/http-tests.mjs",
    "agent-ops:test": "node --test tests/agent-ops/*.test.mjs",
    "agent-ops:quality": "node scripts/agent_ops/quality-gate.mjs",
    "agent-ops:review": "node scripts/agent_ops/review-pack.mjs",
    "agent-ops:evals": "node scripts/agent_ops/run-skill-evals.mjs --dry-run --split optimization"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
