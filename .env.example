# PRODES Commerce (SITE) — exemple de réglages. Copier en `.env.local` (ou dans le fichier d'environnement du service) et remplir. AUCUNE valeur réelle ici :
# les clés et les mots de passe ne sont jamais écrits dans Git. Un test (tests/nav/env-example.test.mjs) vérifie que ce fichier nomme exactement les variables lues par le code.
#
# UN SEUL PROCESSUS de site tourne sur le serveur (une seule instance du service). Ce que le site garde en mémoire (réglages, redirections, images) est invalidé par les publications
# reçues par CE processus ; avec un second processus, une publication ne serait vue par l'autre qu'au bout de 30 secondes au plus.

# --- Obligatoires ---------------------------------------------------------------------------------------------------------------------------------------------------

# Mode de l'instance : staging (tampon, recette) ou production.
SITE_ENV=staging

# Base PostgreSQL du site (nom de base prodes_site*, hôte local sauf SITE_ALLOW_REMOTE_DB=1). Le site n'écrit rien sur disque : catalogue, contenus et images sont dans cette base.
SITE_DATABASE_URL=postgres://UTILISATEUR:MOT_DE_PASSE@localhost:5432/prodes_site

# Catalogue : db (base ci-dessus) ou fixture (démonstration locale seulement).
SITE_CATALOG_SOURCE=db

# Trousseau de clés partagé avec la Factory (fichier JSON hors Git) et clé qui signe les accusés (statut ACTIVE, usage activation_ack).
SITE_KEYRING_PATH=/chemin/vers/trousseau.json
SITE_ACK_KEY_ID=IDENTIFIANT_DE_LA_CLE_D_ACCUSE
# Cercle 5 : trousseau des routes de la Factory vers le site (effacement, PDF, mise de côté, état de l'accusé), hors C0, une portée par route.
SITE_REQUESTS_KEYRING_PATH=/chemin/vers/trousseau-des-routes.json
# Cercle 5 : jours de conservation des coordonnées après l'acquittement de la Factory (défaut 30).
SITE_REQUESTS_RETENTION_DAYS=30
# Cercle 5 : accusé au client. Deux modes livrés, aucun n'envoie : « garde » (valeur d'usine : le message est fabriqué et rangé) et « fichier »
# (B-3 : le message est écrit en .eml dans SITE_ACK_MAIL_DIR, rien ne sort). « smtp » refuse de démarrer ;
# une valeur inconnue refuse le démarrage du serveur avec « SITE_ACK_MAIL_MODE inconnu ».
SITE_ACK_MAIL_MODE=garde
# Mode « fichier » seulement : dossier absolu et privé des .eml d'essai (jamais sous public/ ni .next/) ; obligatoire dans ce mode.
SITE_ACK_MAIL_DIR=
# Mode « fichier » seulement : attente, en minutes (entier de 0 à 120, 15 par défaut), du PDF déposé par la Factory avant d'écrire le message
# avec le lien seul ; 0 = ne pas attendre.
SITE_ACK_PDF_WAIT_MINUTES=
# Paquet B (non livré) : réglages SMTP du serveur ; le mot de passe est dans un fichier hors Git, jamais dans une variable.
SITE_SMTP_HOST=
SITE_SMTP_PORT=587
SITE_SMTP_SECURITY=starttls
SITE_SMTP_USER=
SITE_SMTP_PASSWORD_FILE=

# Politique de retrait : max_withdrawals_without_release = null n'est admis qu'avec SITE_ENV=staging.
SITE_WITHDRAWAL_HOLD_POLICY={"max_withdrawals_without_release":null,"released_expected_withdrawals_digest":null}

# Adresse publique du site (https://… sans barre finale) : sert au plan du site, aux adresses canoniques et au référencement. Jamais écrite en dur dans le code.
SITE_PUBLIC_ORIGIN=https://exemple.invalid

# --- Demandes en ligne (devis et commandes) ---------------------------------------------------------------------------------------------------------------------------
# closed     : la demande en ligne n'est pas ouverte — les pages le disent, rien n'est lu ni enregistré (réglage du tampon pendant tout le cercle 4).
# postgresql : devis et commandes enregistrés dans la base. Absent : vérification seule, rien d'enregistré (essais).
SITE_BUSINESS_PERSISTENCE=closed

# --- Derrière un frontal (Caddy) --------------------------------------------------------------------------------------------------------------------------------------
# Nombre de frontaux devant le site : l'adresse du visiteur est la n-ième en partant de la droite de l'en-tête posé par le frontal. 0 ou absent = aucun frontal, l'en-tête est ignoré.
SITE_TRUSTED_PROXY_HOPS=1
# En-tête qui porte l'adresse (par défaut x-forwarded-for).
SITE_CLIENT_ADDRESS_HEADER=x-forwarded-for

# Routes que la Factory appelle : adresses autorisées (séparées par des virgules ; vide = pas de liste) et refus tolérés par minute et par adresse : signature refusée, corps trop gros, requête mal formée (30 par défaut).
# Une requête bien signée n'est jamais limitée (republier tout le catalogue envoie des milliers d'images).
SITE_MACHINE_ALLOWLIST=
SITE_MACHINE_FAILURE_LIMIT=30

# Envois de devis, de commande et de demande libre : au plus ce nombre par minute et par adresse (5 par défaut) ; le suivant reçoit « trop de demandes, réessayez dans une minute ».
SITE_REQUEST_LIMIT=5

# Consultations de reçu : au plus ce nombre par minute et par adresse (5 par défaut) ; la suivante reçoit 429 « trop de demandes, réessayez dans une minute ».
SITE_RECEIPT_LIMIT=5

# --- Mémoire, état du serveur -----------------------------------------------------------------------------------------------------------------------------------------
# Cache mémoire des images (Mo, 256 par défaut, 0 = aucun).
SITE_MEDIA_CACHE_MB=256
# Âge maximal (secondes) d'une valeur gardée en mémoire (réglages, redirections, images) sans revérifier en base : 30 par défaut, 0 = toujours revérifier (essais).
SITE_MEMORY_MAX_AGE_SECONDS=30
# Commit réellement servi (posé par le déploiement) : 7 à 64 caractères hexadécimaux.
SITE_COMMIT=
# Disque dont l'espace libre est relevé (le dossier courant par défaut).
SITE_DISK_PATH=
# Fichier d'état que la sauvegarde écrit : {"date_utc","fichier","octets"}. Absent : « dernière sauvegarde inconnue ».
SITE_BACKUP_STAMP_PATH=

# --- Facultatifs ------------------------------------------------------------------------------------------------------------------------------------------------------
# Moteurs de recherche : fermé tant que la valeur n'est pas « open » (décision de l'Owner).
SITE_SEARCH_ENGINES=
# Base distante : 1 pour admettre un hôte de base non local (jamais JARVIS).
SITE_ALLOW_REMOTE_DB=
# Fenêtre anti-rejeu des relevés d'événements, en secondes (5 à 3600, 300 par défaut).
SITE_EVENTS_POLL_WINDOW_SECONDS=
# Dossier des contenus éditoriaux partagés de l'ancienne version (lu seulement si aucun contenu n'a été reçu par le canal signé).
SITE_CONTENT_DIR=
# Démonstrations et tests seulement (ignorés en production) : instant figé, scénario de démonstration, images de recette.
SITE_NOW_UTC=
SITE_CATALOG_FIXTURE=
SITE_RECETTE_SHOW_STAGING_IMAGES=
# Fiche PDF à la demande : nombre de fabrications simultanées par processus (1 à 4, 1 par défaut).
PDF_MAX_PARALLEL=

# CA-9 : nom du contrat Factory ; prioritaire sur SITE_REQUESTS_KEYRING_PATH si renseigné.
PRODES_SITE_REQUESTS_KEYRING_PATH=
